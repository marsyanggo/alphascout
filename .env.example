# Copy to `.env` and fill in. The scripts also read these from your shell
# environment, or fall back to ~/workspace/dexter/.env if present.

# Financial Datasets API (https://financialdatasets.ai) — used by fd.py
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-key

# Finnhub API (free key at https://finnhub.io/register) — used by finnhub.py
FINNHUB_API_KEY=your-finnhub-key

# yfinance (yf.py) needs NO key.
